+
+        return rl_obs, high_res_images
+
+    def get_nut_initial_state(
+        self, object_start_idx: int | None = None
+    ) -> tuple[float, float, float]:
+        """Extract (x, y, yaw) of the nut from the current sim state.
+
+        Returns:
+            Tuple of (x, y, yaw) where yaw is derived from the quaternion
+            via yaw = 2 * atan2(qz, qw).
+        """
+        if object_start_idx is None:
+            assert self._square_nut_qpos_idx is not None, (
+                "get_nut_initial_state requires NutAssemblySquare env "
+                "or an explicit object_start_idx"
+            )
+            object_start_idx = self._square_nut_qpos_idx
+        qpos = self.env.sim.data.qpos[object_start_idx : object_start_idx + 7]
+        x, y = float(qpos[0]), float(qpos[1])
+        qw, qx, qy, qz = qpos[3], qpos[4], qpos[5], qpos[6]
+        yaw = float(2.0 * np.arctan2(qz, qw))
+        return (x, y, yaw)
