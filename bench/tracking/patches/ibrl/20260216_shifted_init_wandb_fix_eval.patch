+    def _scale_range(self, value_range, scale: float) -> tuple[float, float]:
+        lo = float(value_range[0])
+        hi = float(value_range[1])
+        center = 0.5 * (lo + hi)
+        half = 0.5 * (hi - lo) * scale
+        return (center - half, center + half)
+
+    def _scale_range_shifted(
+        self, value_range, scale: float, new_center: float
+    ) -> tuple[float, float]:
+        """Scale to fraction of original span, centered at new_center, clamped to bounds."""
+        lo = float(value_range[0])
+        hi = float(value_range[1])
+        half = 0.5 * (hi - lo) * scale
+        # Clamp center so the box stays within original bounds
+        clamped = max(lo + half, min(hi - half, new_center))
+        return (clamped - half, clamped + half)
+
+    def _apply_square_init_scale(
+        self,
+        env_name: str,
+        square_init_scale: float,
+        square_init_center: Optional[tuple[float, float, float]] = None,
+    ) -> None:
+        if env_name != "NutAssemblySquare":
+            return
+        if square_init_scale == 1.0 and square_init_center is None:
+            return
+
+        placement_initializer = getattr(self.env, "placement_initializer", None)
+        if not isinstance(placement_initializer, SequentialCompositeSampler):
+            raise RuntimeError(
+                "NutAssemblySquare placement_initializer is not SequentialCompositeSampler; "
+                "cannot apply square_init_scale."
+            )
+
+        square_sampler = placement_initializer.samplers.get("SquareNutSampler")
+        if square_sampler is None:
+            raise RuntimeError("SquareNutSampler not found; cannot apply square_init_scale.")
+
+        if square_init_center is not None:
+            cx, cy, cyaw = square_init_center
+            # Shifted + scaled: place the 10% box at the specified center,
+            # clamped to the original sampler bounds.
+            square_sampler.x_range = self._scale_range_shifted(
+                square_sampler.x_range, square_init_scale, cx
+            )
+            square_sampler.y_range = self._scale_range_shifted(
+                square_sampler.y_range, square_init_scale, cy
+            )
+            yaw_span = 2.0 * math.pi * square_init_scale
+            half_yaw = 0.5 * yaw_span
+            square_sampler.rotation = (cyaw - half_yaw, cyaw + half_yaw)
+        else:
+            # Default: scale around original center
+            square_sampler.x_range = self._scale_range(square_sampler.x_range, square_init_scale)
+            square_sampler.y_range = self._scale_range(square_sampler.y_range, square_init_scale)
+            yaw_span = 2.0 * math.pi * square_init_scale
+            half_yaw = 0.5 * yaw_span
+            square_sampler.rotation = (math.pi - half_yaw, math.pi + half_yaw)
+
+        print(f"SquareNut init: x_range={square_sampler.x_range}, "
+              f"y_range={square_sampler.y_range}, "
+              f"rotation={tuple(f'{math.degrees(r):.1f}°' for r in square_sampler.rotation)}")
+
