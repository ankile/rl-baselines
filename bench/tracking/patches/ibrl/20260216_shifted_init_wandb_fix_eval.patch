+        # Override the object portion of qpos.
+        object_end_idx = object_start_idx + len(object_qpos)
+        self.env.sim.data.qpos[object_start_idx:object_end_idx] = object_qpos
+        self.env.sim.forward()
+
+        # Clear observation cache and re-extract.
+        base_env = self.env
+        while hasattr(base_env, "env"):
+            base_env = base_env.env
+        base_env._obs_cache = {}
+        obs = self.env._get_observations(force_update=True)
+
+        rl_obs, high_res_images = self._extract_images(obs)
+
+        if self.cond_action > 0:
