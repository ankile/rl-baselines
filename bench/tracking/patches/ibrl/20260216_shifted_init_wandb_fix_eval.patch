+        self, object_qpos: np.ndarray, object_start_idx: int | None = None
+    ) -> tuple[dict[str, torch.Tensor], dict[str, torch.Tensor]]:
+        """Reset with a specific object qpos (7D: x,y,z,qw,qx,qy,qz).
